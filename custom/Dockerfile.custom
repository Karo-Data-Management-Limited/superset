######################################################################
# Custom Superset Dockerfile
# Extends the official Apache Superset image with organization-specific packages
######################################################################

# Use the official Superset image as base
# Update this version tag when upgrading Superset
FROM apache/superset:6.0.0

USER root
ENV DEBIAN_FRONTEND=noninteractive

# Install minimal system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install dockerize (required for init containers in Kubernetes)
ENV DOCKERIZE_VERSION v0.7.0
RUN wget -O - https://github.com/jwilder/dockerize/releases/download/$DOCKERIZE_VERSION/dockerize-linux-amd64-$DOCKERIZE_VERSION.tar.gz | tar xzf - -C /usr/local/bin

# Copy custom requirements file
COPY custom/requirements.txt /app/custom/requirements.txt

# Install custom Python packages using uv (Superset 6.0.0+ uses uv instead of pip)
RUN . /app/.venv/bin/activate && \
    if [ -s /app/custom/requirements.txt ]; then \
        uv pip install --no-cache-dir -r /app/custom/requirements.txt; \
    else \
        echo "No custom requirements to install"; \
    fi

# Copy custom logo (if it exists)
# Add your logo.png to the custom/ directory
COPY custom/logo.png /app/superset/static/assets/images/karo_logo.png 2>/dev/null || echo "No custom logo found, skipping..."

USER superset
